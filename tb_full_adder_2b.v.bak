/*=====================
        2bit FULL-ADDER
=======================
Description:
	This is a 2bit full-adder module using behavioral modeling.
	
Design Engineer:
	Daniel A. Udasco
	
Date: 7 May 2026
--------------------------------------------------------*/
module full_adder_2b(S, A, B);
	// ports
	input  [1:0] A;
	input  [1:0] B;
	output [2:0] S;
	wire         w;
	
	
	// half-adder instances
	half_adder ha(
		.sum  (S[0]),
		.carry(w),
		.A    (A[0]),
		.B    (B[0])
	);
	
	// full-adder instances
	full_adder fa(
		.sum  (S[1]),
		.cout (S[2]),
		.A    (A[1]),
		.B    (B[1]),
		.cin  (w)
	);
	
	
endmodule